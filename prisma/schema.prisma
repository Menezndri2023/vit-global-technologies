generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum UserRole {
  CLIENT
  PARTNER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CLIENT)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CalendarConnection {
  id           String   @id @default(cuid())
  provider     String
  accountEmail String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Signature {
  id              String       @id @default(cuid())
  quoteId         String       @unique
  quote           QuoteRequest @relation(fields: [quoteId], references: [id])
  signerName      String
  signerEmail     String
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime     @default(now())
  // Preuve : version de la proposition signée, copie figée de son contenu, empreinte SHA-256 et texte de consentement affiché.
  proposalVersion Int?
  snapshot        Json?
  documentHash    String?
  consentText     String?
  locale          String?
}

// Lien de signature à usage unique : seul le hash SHA-256 du jeton est stocké.
model QuoteSignToken {
  id              String       @id @default(cuid())
  quoteId         String
  quote           QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  proposalVersion Int
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime     @default(now())

  @@index([quoteId])
}

// Compteur de limitation de fréquence partagé entre toutes les instances serverless.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ContactMessage {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String
  locale    String     @default("fr")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([email])
}

model QuoteRequest {
  id             String     @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  country        String?
  service        String
  budget         String?
  timeline       String?
  description    String
  attachmentData     Bytes?
  attachmentName     String?
  attachmentMimeType String?
  customPricing  Json?
  // Proposition figée envoyée pour signature (copie de customPricing au moment de l'envoi).
  proposal        Json?
  proposalVersion Int        @default(0)
  proposalSentAt  DateTime?
  locale         String     @default("fr")
  status         LeadStatus @default(NEW)
  createdAt      DateTime   @default(now())
  signature      Signature?
  signTokens     QuoteSignToken[]

  @@index([email])
}

model Appointment {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  topic     String
  expert    String?
  mode      String?
  date      DateTime
  timeSlot  String
  notes     String?
  locale    String     @default("fr")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([email])
  @@index([date, timeSlot])
}

model JobApplication {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  position    String
  portfolioUrl String?
  linkedinUrl String?
  message     String?
  locale      String     @default("fr")
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())

  @@index([email])
}

model PartnerRequest {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String
  country     String?
  partnerType String
  message     String
  locale      String     @default("fr")
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())

  @@index([email])
}

model ChatLead {
  id        String     @id @default(cuid())
  name      String?
  email     String?
  message   String
  page      String?
  locale    String     @default("fr")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}
