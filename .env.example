# --- Base de données (PostgreSQL — ex: Render, Neon, Vercel Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Accès admin (tableau de bord /admin) ---
ADMIN_PASSWORD="change-me"

# --- Auth.js (connexion Espace client / Espace partenaire) ---
# Génère un secret aléatoire : `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="https://www.vit-global.tech"
NEXTAUTH_URL="https://www.vit-global.tech"
NEXT_PUBLIC_SITE_URL="https://www.vit-global.tech"

# Google OAuth (login) — https://console.cloud.google.com/apis/credentials
# Créer un "OAuth client ID" de type "Web application"
# Redirect URI à autoriser : {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID / Azure AD (login) — https://portal.azure.com > App registrations
# Redirect URI à autoriser : {AUTH_URL}/api/auth/callback/microsoft-entra-id
# ISSUER format : https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# LinkedIn OAuth (login) — https://www.linkedin.com/developers/apps
# Redirect URI à autoriser : {AUTH_URL}/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# --- Envoi d'emails (notifications admin + confirmations client) ---
# Recommandé : Zoho Mail avec contact@vit-global.tech
#   Zoho → Mon compte → Sécurité → Mots de passe spécifiques à l'application → générer
#   SMTP_HOST="smtp.zoho.com"  SMTP_PORT="465"  SMTP_USER="contact@vit-global.tech"
# Alternative Gmail : laisser SMTP_HOST vide et utiliser un mot de passe d'application Gmail
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER=""                    # ex: contact@vit-global.tech
SMTP_APP_PASSWORD=""            # mot de passe d'application (pas le mot de passe du compte)
ADMIN_NOTIFY_EMAIL=""           # adresse qui reçoit les notifications (défaut : contact@vit-global.tech)

# --- Twilio (SMS + WhatsApp) — https://console.twilio.com ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""              # numéro Twilio au format +2250700000000
TWILIO_WHATSAPP_FROM=""         # numéro WhatsApp Twilio approuvé, ex: +14155238886 (sandbox)
ADMIN_NOTIFY_PHONE=""           # numéro WhatsApp de l'équipe à notifier, format +225...

# --- Synchronisation calendrier (réutilise les identifiants Google / Microsoft ci-dessus) ---
# Ces URLs doivent aussi être ajoutées comme "Redirect URI" autorisées dans Google Cloud / Azure
GOOGLE_CALENDAR_REDIRECT_URI="https://www.vit-global.tech/api/admin/calendar/google/callback"
MICROSOFT_CALENDAR_REDIRECT_URI="https://www.vit-global.tech/api/admin/calendar/microsoft/callback"

# --- À venir (non implémenté pour l'instant) ---
# Paiement en ligne (Stripe / CinetPay / PayDunya...) — à définir plus tard
